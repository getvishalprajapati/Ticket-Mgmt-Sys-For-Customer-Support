# Dependency policy for the local PGlite database runtime.
# Only resolve package versions published on or before the cutoff date.
before=2026-09-25T23:59:59Z
# Record exact versions, never ranges.
save-exact=true
# Refuse to install on a Node.js version outside package.json "engines" (Node 22).
engine-strict=true
fund=false
update-notifier=false
