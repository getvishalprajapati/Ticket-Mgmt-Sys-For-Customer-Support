# Crescent Motors Ticket Service - example configuration.
# Copy to .env and replace the placeholders. Never commit .env.

# Runtime environment: development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Shared secret that internal callers must send in the X-API-Key header.
# Use at least 32 random characters, for example the output of:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The service refuses to start while this placeholder is still in place.
API_KEY=replace-with-a-long-random-api-key

# Local PGlite socket server started by database/start-db.mjs (localhost only).
# PGlite does not support encrypted connections, so local SSL is disabled.
# PGlite ignores the user name, password and database name.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable

# Future Supabase example (not used in Version 1). Non-local hosts must use
# sslmode=require, verify-ca or verify-full or the service refuses to start.
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/postgres?sslmode=require

# Connection pool. PGlite executes one query at a time, so keep this conservative.
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=5

# Version 1 serves a single company, created by the database migrations.
COMPANY_NAME=Crescent Motors

# Used only by scripts/smoke_test.py
SMOKE_TEST_BASE_URL=http://127.0.0.1:8000
